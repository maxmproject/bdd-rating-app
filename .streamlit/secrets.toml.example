# คัดลอกเป็น .streamlit/secrets.toml (ห้าม commit) หรือวางในหน้า Secrets ของ Streamlit Cloud
# Postgres ฟรี: Supabase / Neon  (บน Streamlit Cloud ห้ามใช้ SQLite เพราะข้อมูลหายเมื่อรีสตาร์ต)
DATABASE_URL = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# password_hash สร้างด้วย: python make_hash.py
[users.pi]
name = "PI"
role = "pi"
password_hash = "pbkdf2_sha256$200000$..."

[users.rater_a]
name = "จิตแพทย์ A"
role = "rater"
rater = "A"
password_hash = "pbkdf2_sha256$200000$..."

[users.rater_b]
name = "จิตแพทย์ B"
role = "rater"
rater = "B"
password_hash = "pbkdf2_sha256$200000$..."

# ---- บัญชีทดสอบ 2 บัญชี (rater = "T1" / "T2") ----
# ผลเก็บแยกจาก A/B: ไม่ถูกนำไปคำนวณ κ, consensus หรือ export · PI ล้างได้ในแท็บความคืบหน้า
[users.test1]
name = "ทดสอบ 1"
role = "rater"
rater = "T1"
password_hash = "pbkdf2_sha256$200000$..."

[users.test2]
name = "ทดสอบ 2"
role = "rater"
rater = "T2"
password_hash = "pbkdf2_sha256$200000$..."
